---
import '@fontsource-variable/inter/opsz.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Wordmark from '../components/Wordmark.astro';
interface Props {
  title: string;
  description: string;
  toc: { label: string; anchor: string; items: { anchor: string; title: string }[] }[];
}
const { title, description, toc } = Astro.props;
// The tabs: the first four `#` parts of the README (Manifesto, the
// Certificate, Human-in-charge, Talaia) are the manifesto tab, the rest is the practice; each tab links to the first heading of its body.
const tabs = [
  { id: 'manifesto', label: 'Manifesto', anchor: toc[0]?.anchor },
  { id: 'teams', label: 'Individuals and Teams', anchor: toc[4]?.anchor },
  { id: 'companies', label: 'Companies', anchor: 'companies' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1a2238" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Markdown version" />
  <!-- Go vanity import path: `go install talaia.dev/cmd/talaia@latest` asks
       https://talaia.dev/?go-get=1 and follows this to the repository. -->
  <meta name="go-import" content="talaia.dev git https://github.com/talaia-dev/talaia" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="talaia" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content="https://talaia.dev/og.png" />
  <meta property="og:image:secure_url" content="https://talaia.dev/og.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="talaia — You direct. The AI builds. Your name answers for it." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://talaia.dev/og.png" />
  <script is:inline>
    // Light by default, like a published standard; dark stays a choice.
    document.documentElement.dataset.theme = localStorage.getItem('theme') ?? 'light';
    // The body opens on the manifesto; the script at the foot of the page
    // moves to the tab an anchor belongs to.
    document.documentElement.dataset.tab = location.hash === '#companies' ? 'companies' : 'manifesto';
  </script>
</head>
<body>
  <header class="topbar">
    <div class="topbar-in">
      <a class="brand" href="/"><Logo size={20} /><Wordmark /></a>
      <nav class="tabs" aria-label="Sections">
        {tabs.map((t) => <a href={`#${t.anchor}`} data-tab={t.id}>{t.label}</a>)}
      </nav>
      <nav class="topnav" aria-label="Repository">
        <a href="https://github.com/talaia-dev/talaia">GitHub</a>
      </nav>
      <button id="theme-toggle" type="button" aria-label="Toggle light/dark theme">◐</button>
      <!-- No effect yet: the translations come later. -->
      <select id="lang-select" aria-label="Language">
        <option value="en" selected>English</option>
        <option value="es">Español</option>
        <option value="ca">Català</option>
      </select>
    </div>
  </header>
  <slot name="hero" />
  <div class="shell">
    <aside class="toc">
      <nav aria-label="On this page">
        {toc.filter((g) => g.items.length > 0).map((g) => (
          <div class="toc-part">
            <p class="toc-part-label">{g.label}</p>
            <ol>
              {g.items.map((s) => <li><a href={`#${s.anchor}`}>{s.title}</a></li>)}
            </ol>
          </div>
        ))}
      </nav>
    </aside>
    <main>
      <slot />
      <footer class="site-foot">
        <p class="foot-line"><a href="/certificate">talaia.dev/certificate</a> — <a href="https://www.linkedin.com/in/roger-p%C3%A9rez-parera-1b1458119/">Roger Pérez</a></p>
        <nav class="foot-links" aria-label="Footer">
          <a href="https://github.com/talaia-dev/talaia">GitHub</a>
          <a href="/llms.txt">llms.txt</a>
          {toc.slice(0, 2).map((g) => <a href={`#${g.anchor}`}>{g.label}</a>)}
        </nav>
      </footer>
    </main>
  </div>
  <script is:inline>
    // Tabs: one page, three bodies. The anchor decides which one shows:
    // none is the manifesto, #companies is Companies, and any other
    // belongs to the tab its target sits in (before or after the
    // README's fifth `#`). The footnotes show under both, so a note's
    // anchor keeps the tab that is open.
    (() => {
      const root = document.documentElement;
      const split = document.querySelector('.readme > h1:nth-of-type(5)');
      const show = () => {
        const id = decodeURIComponent(location.hash.slice(1));
        const el = id ? document.getElementById(id) : null;
        let tab = root.dataset.tab;
        if (!id) tab = 'manifesto';
        else if (id === 'companies') tab = 'companies';
        else if (el && el.closest('.readme') && !el.closest('.footnotes'))
          tab = split && !(split.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_PRECEDING) ? 'teams' : 'manifesto';
        root.dataset.tab = tab;
        for (const a of document.querySelectorAll('.tabs a'))
          a.dataset.tab === tab ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current');
        if (el) el.scrollIntoView();   // the browser cannot scroll to a target that was hidden
      };
      addEventListener('hashchange', show);
      show();
    })();
    // Scroll-spy: the index highlights the section whose heading was the
    // last to pass under the top bar. Headings are the README's ## (the
    // hidden "Introduction" ones included: absolute-positioned, but they
    // keep their place in the flow).
    (() => {
      const links = new Map(
        [...document.querySelectorAll('.toc a[href^="#"]')].map((a) => [a.getAttribute('href').slice(1), a])
      );
      const headings = [...document.querySelectorAll('.readme h2[id]')].filter((h) => links.has(h.id));
      if (!headings.length) return;
      let current = null, ticking = false;
      const update = () => {
        ticking = false;
        const line = 96; // just under the sticky top bar
        let active = null;
        for (const h of headings) {
          if (!h.getClientRects().length) continue;   // in a tab that is not showing
          if (!active || h.getBoundingClientRect().top <= line) active = h; else break;
        }
        if (active === current) return;
        if (current) links.get(current.id).removeAttribute('aria-current');
        if (active) links.get(active.id).setAttribute('aria-current', 'true');
        current = active;
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll);
      addEventListener('hashchange', onScroll);
      update();
    })();
    document.getElementById('theme-toggle').addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  </script>
</body>
</html>
